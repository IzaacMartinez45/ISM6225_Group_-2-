@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <h1>Track Stocks.<br /><span>Stay Ahead.</span></h1>
    <p>Monitor your watchlist, set target prices, and compare them against live market data — all in one clean dashboard.</p>
    <div class="mt-4 d-flex gap-3 flex-wrap">
        <a class="btn btn-primary btn-lg" asp-controller="Watchlist" asp-action="Index">
            View Watchlist →
        </a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Watchlist" asp-action="Create">
            + Add Stock
        </a>
    </div>
</div>

<div class="row mt-4 g-3">
    <div class="col-md-3 col-sm-6">
        <div class="feature-card">
            <div class="icon">📋</div>
            <h5>Add Stocks</h5>
            <p>Add any ticker symbol like AAPL or TSLA and set your personal target price.</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="feature-card">
            <div class="icon">📡</div>
            <h5>Live Market Data</h5>
            <p>Previous day close, high, low, and volume pulled live from the Polygon.io API.</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="feature-card">
            <div class="icon">🎯</div>
            <h5>Price Targets</h5>
            <p>See exactly how far the current price is from your target — green or red.</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="feature-card">
            <div class="icon">✏️</div>
            <h5>Full CRUD</h5>
            <p>Create, view, edit, and delete stocks from your watchlist at any time.</p>
        </div>
    </div>
</div>
