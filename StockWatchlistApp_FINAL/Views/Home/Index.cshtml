@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <h1>📈 Stock Watchlist Tracker</h1>
    <p>Monitor your favorite stocks, set target prices, and track live market data — all in one place.</p>
    <a class="btn btn-light btn-lg fw-semibold mt-3" asp-controller="Watchlist" asp-action="Index">
        Go to My Watchlist →
    </a>
</div>

<div class="row mt-5 g-4 text-center">
    <div class="col-md-4">
        <div class="card p-4 h-100 shadow-sm">
            <div style="font-size:2.5rem">📋</div>
            <h5 class="mt-3">Track Stocks</h5>
            <p class="text-muted">Add any stock by ticker symbol and keep notes on why you're watching it.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 shadow-sm">
            <div style="font-size:2.5rem">🎯</div>
            <h5 class="mt-3">Set Target Prices</h5>
            <p class="text-muted">Define your buy or sell targets and see how far the market is from your goal.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 shadow-sm">
            <div style="font-size:2.5rem">📡</div>
            <h5 class="mt-3">Live Market Data</h5>
            <p class="text-muted">Pulls previous day close, high, low, and volume from the Polygon.io API.</p>
        </div>
    </div>
</div>
