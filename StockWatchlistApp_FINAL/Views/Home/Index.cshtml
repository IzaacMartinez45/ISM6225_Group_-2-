@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <h1>📈 Stock Watchlist Tracker</h1>
    <p>Monitor your favorite stocks, set target prices, and track live market data — all in one place.</p>
    <div class="mt-4">
        <a class="btn btn-light btn-lg fw-semibold me-2" asp-controller="Watchlist" asp-action="Index">
            Go to My Watchlist →
        </a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Home" asp-action="AboutUs">
            About Us
        </a>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-3 mb-3">
        <div class="card p-4 h-100 shadow-sm">
            <div style="font-size:2.5rem">📋</div>
            <h5 class="fw-semibold mt-2">Add Stocks</h5>
            <p class="text-muted small">Add stock symbols like AAPL or TSLA and set your target price.</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-4 h-100 shadow-sm">
            <div style="font-size:2.5rem">📡</div>
            <h5 class="fw-semibold mt-2">Live Prices</h5>
            <p class="text-muted small">Current closing prices are pulled from the Polygon.io API.</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-4 h-100 shadow-sm">
            <div style="font-size:2.5rem">🎯</div>
            <h5 class="fw-semibold mt-2">Price Difference</h5>
            <p class="text-muted small">The app calculates the difference between current and target price.</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-4 h-100 shadow-sm">
            <div style="font-size:2.5rem">✏️</div>
            <h5 class="fw-semibold mt-2">Full CRUD</h5>
            <p class="text-muted small">You can create, view, edit, and delete stocks from your list.</p>
        </div>
    </div>
</div>
