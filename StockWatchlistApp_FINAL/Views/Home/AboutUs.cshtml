@{
    ViewData["Title"] = "About Us";
}

<section class="space-y-stack-lg max-w-7xl mx-auto w-full mt-stack-lg">

    <!-- Hero Header -->
    <div class="space-y-stack-md">
        <h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">
            Built for Analytics. <span class="text-[#adc6ff]">Designed for Clarity.</span>
        </h2>
        <p class="font-body-base text-on-surface-variant max-w-2xl">
            We are Group 2 from ISM6225 — Application Development for Analytics. We built StockTracker,
            a full-stack ASP.NET Core MVC application with live market data from Polygon.io, full CRUD operations,
            and deployment on Azure.
        </p>
    </div>

    <!-- Team Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter mt-12">

        <!-- Santiago -->
        <div class="md:col-span-2 group flex flex-row items-center rounded-xl bg-surface-container border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-stack-lg gap-6 overflow-hidden relative">
            <div class="flex-1 space-y-3">
                <div>
                    <h3 class="font-headline-md text-headline-md text-[#adc6ff]">Santiago Vela</h3>
                    <p class="font-label-caps text-label-caps text-on-surface-variant uppercase mt-1">Home Page &amp; Navigation</p>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                    Built the landing page, About Us page, and set up the navbar links and routing structure.
                </p>
                <span class="inline-block text-[10px] font-bold text-blue-400 bg-blue-500/10 px-2 py-1 rounded uppercase tracking-wider">Frontend</span>
            </div>
            <div class="w-16 h-16 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center shrink-0">
                <span class="font-black text-blue-400 text-xl">SV</span>
            </div>
        </div>

        <!-- Aitemir -->
        <div class="md:col-span-1 group flex flex-col rounded-xl bg-surface-container border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-stack-md">
            <div class="w-14 h-14 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center mb-stack-md">
                <span class="font-black text-yellow-400 text-lg">AK</span>
            </div>
            <h3 class="font-headline-md text-lg text-on-surface">Aitemir Kermaliev</h3>
            <p class="font-label-caps text-label-caps text-secondary mb-stack-sm">Azure &amp; API Config</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant flex-1">
                Handled Azure App Service deployment and configured the Polygon.io API key as an Azure App Setting.
            </p>
            <span class="inline-block mt-3 text-[10px] font-bold text-yellow-400 bg-yellow-500/10 px-2 py-1 rounded uppercase tracking-wider">DevOps</span>
        </div>

        <!-- Izaac -->
        <div class="md:col-span-1 group flex flex-col rounded-xl bg-surface-container border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-stack-md">
            <div class="w-14 h-14 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center mb-stack-md">
                <span class="font-black text-purple-400 text-lg">IM</span>
            </div>
            <h3 class="font-headline-md text-lg text-on-surface">Izaac Martinez</h3>
            <p class="font-label-caps text-label-caps text-secondary mb-stack-sm">README &amp; ERD &amp; Git Log</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant flex-1">
                Wrote the GitHub README, created the ERD diagram, and prepared the git log for submission.
            </p>
            <span class="inline-block mt-3 text-[10px] font-bold text-purple-400 bg-purple-500/10 px-2 py-1 rounded uppercase tracking-wider">Documentation</span>
        </div>

        <!-- Ismail -->
        <div class="md:col-span-2 group flex flex-row items-center rounded-xl bg-surface-container-high border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-stack-lg gap-6 overflow-hidden relative">
            <div class="flex-1 space-y-3">
                <div>
                    <h3 class="font-headline-md text-headline-md text-[#adc6ff]">Ismail Jhaveri</h3>
                    <p class="font-label-caps text-label-caps text-on-surface-variant uppercase mt-1">UI &amp; Presentation</p>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                    Overhauled the UI with a dark finance theme, improved form validation, managed git workflow and branch merging.
                </p>
                <span class="inline-block text-[10px] font-bold text-green-400 bg-green-500/10 px-2 py-1 rounded uppercase tracking-wider">UI / Git</span>
            </div>
            <div class="w-16 h-16 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center shrink-0">
                <span class="font-black text-green-400 text-xl">IJ</span>
            </div>
            <div class="absolute -right-4 -bottom-4 opacity-10">
                <span class="material-symbols-outlined text-[#adc6ff]" style="font-size:100px;">palette</span>
            </div>
        </div>

        <!-- GitHub CTA -->
        <div class="md:col-span-2 group flex flex-col justify-center rounded-xl bg-[#4d8eff]/10 border border-[#4d8eff]/20 p-stack-lg relative overflow-hidden">
            <div class="relative z-10">
                <h3 class="font-headline-md text-headline-md text-[#adc6ff]">GitHub Repository</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-stack-sm max-w-md">
                    View our README for technical details — API endpoints, data model ERD, CRUD overview, and challenges we solved.
                </p>
                <a class="inline-flex items-center mt-stack-lg bg-[#adc6ff] text-[#001a42] font-label-caps text-label-caps px-stack-md py-stack-sm rounded hover:bg-[#d8e2ff] transition-colors"
                   href="https://github.com/IzaacMartinez45/ISM6225_Group_-2-" target="_blank">
                    <span class="material-symbols-outlined mr-2 text-sm">terminal</span>VIEW ON GITHUB
                </a>
            </div>
            <div class="absolute right-0 top-0 h-full w-1/3 bg-gradient-to-l from-[#4d8eff]/5 to-transparent flex items-center justify-center">
                <span class="material-symbols-outlined text-[#4d8eff]/30 text-8xl" style="font-variation-settings: 'FILL' 1;">code</span>
            </div>
        </div>
    </div>

    <!-- Values Section -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-stack-lg border-t border-outline-variant pt-stack-lg">
        <div class="space-y-stack-sm">
            <span class="material-symbols-outlined text-[#adc6ff]">monitoring</span>
            <h4 class="font-headline-md text-lg text-on-surface">Live Market Data</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Previous day OHLCV data sourced directly from Polygon.io for every stock in your watchlist.</p>
        </div>
        <div class="space-y-stack-sm">
            <span class="material-symbols-outlined text-[#adc6ff]">database</span>
            <h4 class="font-headline-md text-lg text-on-surface">Full CRUD Control</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Create, read, update, and delete stocks with a singleton service managing in-memory persistence.</p>
        </div>
        <div class="space-y-stack-sm">
            <span class="material-symbols-outlined text-[#adc6ff]">cloud</span>
            <h4 class="font-headline-md text-lg text-on-surface">Azure Deployed</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Fully deployed on Azure App Service with the API key configured as a secure App Setting.</p>
        </div>
    </div>

</section>
