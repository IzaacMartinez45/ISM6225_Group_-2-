@{
    ViewData["Title"] = "About Us";
}

<section class="space-y-stack-lg max-w-7xl mx-auto w-full mt-stack-lg">

    <!-- Hero Header -->
    <div class="space-y-stack-md">
        <h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">
            Built for Analytics. <span class="text-[#adc6ff]">Designed for Clarity.</span>
        </h2>
        <p class="font-body-base text-on-surface-variant max-w-2xl">
            We are Group 2 from ISM6225 — Application Development for Analytics. StockTracker is a full-stack ASP.NET Core MVC application that combines watchlist CRUD functionality, SQLite persistence, live Polygon.io market data, and Azure deployment.
        </p>
    </div>

    <!-- Team Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mt-8">

        <!-- Santiago -->
        <article class="group h-full rounded-xl bg-surface-container border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-5">
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                <div class="w-32 h-32 rounded-full overflow-hidden border border-blue-500/30 shrink-0 mx-auto sm:mx-0">
                <img src="~/images/team/santiago.jpg" asp-append-version="true" alt="Santiago Vela" class="w-full h-full object-cover" />
                </div>
                <div class="flex flex-col gap-2 text-center sm:text-left">
                    <h3 class="font-headline-md text-xl text-on-surface">Santiago Vela</h3>
                    <p class="font-label-caps text-label-caps text-[#adc6ff] uppercase">Frontend Structure &amp; Navigation</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                        Built the landing page and About Us page, and helped organize the site navigation and page routing structure.
                    </p>
                    <span class="inline-flex w-fit items-center justify-center sm:justify-start mt-1 text-[10px] font-bold text-blue-300 bg-blue-500/10 border border-blue-500/20 px-2 py-1 rounded uppercase tracking-wider">FRONTEND</span>
                </div>
            </div>
        </article>

        <!-- Aitemir -->
        <article class="group h-full rounded-xl bg-surface-container border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-5">
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                <div class="w-32 h-32 rounded-full overflow-hidden border border-emerald-500/30 shrink-0 mx-auto sm:mx-0">
                <img src="~/images/team/aitemir.jpg" asp-append-version="true" alt="Aitemir Kermaliev" class="w-full h-full object-cover" />
                </div>
                <div class="flex flex-col gap-2 text-center sm:text-left">
                    <h3 class="font-headline-md text-xl text-on-surface">Aitemir Kermaliev</h3>
                    <p class="font-label-caps text-label-caps text-[#adc6ff] uppercase">Backend Validation &amp; Database Testing</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                        Verified the solution setup, tested local migrations and SQLite persistence, and validated the full CRUD workflow and application stability.
                    </p>
                    <span class="inline-flex w-fit items-center justify-center sm:justify-start mt-1 text-[10px] font-bold text-emerald-300 bg-emerald-500/10 border border-emerald-500/20 px-2 py-1 rounded uppercase tracking-wider">BACKEND / QA</span>
                </div>
            </div>
        </article>

        <!-- Izaac -->
        <article class="group h-full rounded-xl bg-surface-container border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-5">
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                <div class="w-32 h-32 rounded-full overflow-hidden border border-violet-500/30 shrink-0 mx-auto sm:mx-0">
                <img src="~/images/team/izaac.jpeg" asp-append-version="true" alt="Izaac Martinez" class="w-full h-full object-cover" />
                </div>
                <div class="flex flex-col gap-2 text-center sm:text-left">
                    <h3 class="font-headline-md text-xl text-on-surface">Izaac Martinez</h3>
                    <p class="font-label-caps text-label-caps text-[#adc6ff] uppercase">Azure Deployment &amp; API Configuration</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                        Deployed the application to Azure App Service and configured the Polygon.io API key and runtime environment settings.
                    </p>
                    <span class="inline-flex w-fit items-center justify-center sm:justify-start mt-1 text-[10px] font-bold text-violet-300 bg-violet-500/10 border border-violet-500/20 px-2 py-1 rounded uppercase tracking-wider">DEVOPS / INTEGRATION</span>
                </div>
            </div>
        </article>

        <!-- Ismail -->
        <article class="group h-full rounded-xl bg-surface-container border border-outline-variant hover:border-[#adc6ff] transition-all duration-300 p-5">
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                <div class="w-32 h-32 rounded-full overflow-hidden border border-cyan-500/30 shrink-0 mx-auto sm:mx-0">
                <img src="~/images/team/ismail.jpg" asp-append-version="true" alt="Ismail Jhaveri" class="w-full h-full object-cover" />
                </div>
                <div class="flex flex-col gap-2 text-center sm:text-left">
                    <h3 class="font-headline-md text-xl text-on-surface">Ismail Jhaveri</h3>
                    <p class="font-label-caps text-label-caps text-[#adc6ff] uppercase">UI Refinement &amp; Presentation</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                        Improved the user interface, refined page styling and layout consistency, and contributed to the final project presentation.
                    </p>
                    <span class="inline-flex w-fit items-center justify-center sm:justify-start mt-1 text-[10px] font-bold text-cyan-300 bg-cyan-500/10 border border-cyan-500/20 px-2 py-1 rounded uppercase tracking-wider">UI / PRESENTATION</span>
                </div>
            </div>
        </article>
    </div>

    <!-- GitHub CTA -->
    <div class="mt-10 group rounded-xl bg-[#4d8eff]/10 border border-[#4d8eff]/20 p-stack-lg relative overflow-hidden">
        <div class="relative z-10 max-w-3xl">
            <h3 class="font-headline-md text-headline-md text-[#adc6ff]">GitHub Repository</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-stack-sm">
                View our README for technical details including API integration, data model structure, CRUD behavior, and implementation notes.
            </p>
            <a class="inline-flex items-center mt-stack-lg bg-[#adc6ff] text-[#001a42] font-label-caps text-label-caps px-stack-md py-stack-sm rounded hover:bg-[#d8e2ff] transition-colors"
               href="https://github.com/IzaacMartinez45/ISM6225_Group_-2-" target="_blank" rel="noopener noreferrer">
                <span class="material-symbols-outlined mr-2 text-sm">terminal</span>VIEW ON GITHUB
            </a>
        </div>
        <div class="absolute right-0 top-0 h-full w-1/3 bg-gradient-to-l from-[#4d8eff]/5 to-transparent hidden md:flex items-center justify-center">
            <span class="material-symbols-outlined text-[#4d8eff]/30 text-8xl" style="font-variation-settings: 'FILL' 1;">code</span>
        </div>
    </div>

    <!-- Values Section -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-stack-lg border-t border-outline-variant pt-stack-lg">
        <div class="space-y-stack-sm">
            <span class="material-symbols-outlined text-[#adc6ff]">monitoring</span>
            <h4 class="font-headline-md text-lg text-on-surface">Live Market Data</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Previous day OHLCV data sourced directly from Polygon.io for every stock in your watchlist.</p>
        </div>
        <div class="space-y-stack-sm">
            <span class="material-symbols-outlined text-[#adc6ff]">database</span>
            <h4 class="font-headline-md text-lg text-on-surface">Full CRUD Control</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Create, read, update, and delete stocks with a singleton service managing in-memory persistence.</p>
        </div>
        <div class="space-y-stack-sm">
            <span class="material-symbols-outlined text-[#adc6ff]">cloud</span>
            <h4 class="font-headline-md text-lg text-on-surface">Azure Deployed</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Fully deployed on Azure App Service with the API key configured as a secure App Setting.</p>
        </div>
    </div>

</section>
