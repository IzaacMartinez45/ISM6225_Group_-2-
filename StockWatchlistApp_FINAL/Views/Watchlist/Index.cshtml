@model List<(StockWatchlistApp.Models.WatchlistStock Stock, StockWatchlistApp.Models.StockApiData ApiData)>

@{
    ViewData["Title"] = "Market Watchlist";
}

<!-- Page Header -->
<div class="flex justify-between items-end mb-stack-lg mt-stack-lg">
    <div>
        <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">Market Watchlist</h1>
        <p class="text-body-sm font-body-sm text-on-surface-variant mt-1">Real-time tracking of your primary asset portfolio.</p>
    </div>
    <div class="flex gap-stack-sm">
        <a asp-action="Create"
           class="bg-[#4d8eff] text-[#00285d] px-4 h-9 flex items-center gap-2 font-label-caps text-label-caps rounded hover:bg-blue-400 transition-colors shadow-lg shadow-blue-500/20">
            <span class="material-symbols-outlined text-sm">add</span>ADD TICKER
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <!-- Empty State -->
    <div class="bg-surface-container border border-outline-variant rounded-xl p-16 text-center">
        <span class="material-symbols-outlined text-slate-600 mb-4" style="font-size:48px;">inbox</span>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Your watchlist is empty</h3>
        <p class="text-on-surface-variant text-body-sm mb-6">Add a stock to start tracking prices and targets.</p>
        <a asp-action="Create"
           class="inline-flex items-center gap-2 bg-[#4d8eff] text-[#00285d] px-6 h-9 font-label-caps text-label-caps rounded hover:bg-blue-400 transition-colors">
            <span class="material-symbols-outlined text-sm">add</span>ADD YOUR FIRST STOCK
        </a>
    </div>
}
else
{
    <!-- Watchlist Table -->
    <div class="bg-surface-container rounded-xl overflow-hidden border border-outline-variant">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-surface-container-high border-b border-outline-variant">
                        <th class="text-left px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Ticker</th>
                        <th class="text-left px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Company</th>
                        <th class="text-left px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Category</th>
                        <th class="text-right px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Target</th>
                        <th class="text-right px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Prev. Close</th>
                        <th class="text-right px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Diff</th>
                        <th class="text-right px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">High</th>
                        <th class="text-right px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Low</th>
                        <th class="text-right px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Volume</th>
                        <th class="text-center px-4 py-3 font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var item in Model)
                    {
                        var stock = item.Stock;
                        var api = item.ApiData;

                        <tr class="hover:bg-surface-variant/30 transition-colors">
                            <td class="px-4 py-2.5">
                                <div class="flex items-center gap-2">
                                    <span class="bg-slate-800 text-slate-100 font-bold px-1.5 py-0.5 rounded text-[11px]">@stock.Ticker</span>
                                    @if (api.IsAvailable)
                                    {
                                        <span class="text-[9px] font-bold text-emerald-400 bg-emerald-400/10 px-1.5 py-0.5 rounded">LIVE</span>
                                    }
                                    else
                                    {
                                        <span class="text-[9px] font-bold text-slate-500 bg-slate-800 px-1.5 py-0.5 rounded">NO DATA</span>
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-2.5 text-data-tabular font-data-tabular text-on-surface">@stock.CompanyName</td>
                            <td class="px-4 py-2.5 text-data-tabular font-data-tabular text-slate-400">@stock.Category</td>
                            <td class="px-4 py-2.5 text-right text-data-tabular font-data-tabular text-on-surface">$@stock.TargetPrice</td>

                            @if (api.IsAvailable)
                            {
                                var aboveTarget = api.PreviousClose >= stock.TargetPrice;
                                var diff = api.PreviousClose - stock.TargetPrice;
                                var arrow = diff >= 0 ? "arrow_drop_up" : "arrow_drop_down";
                                var colorClass = diff >= 0 ? "stock-up" : "stock-down";

                                <td class="px-4 py-2.5 text-right text-data-tabular font-data-tabular @(aboveTarget ? "stock-up" : "stock-down")">
                                    $@api.PreviousClose
                                </td>
                                <td class="px-4 py-2.5 text-right text-data-tabular font-data-tabular @colorClass">
                                    <div class="flex items-center justify-end gap-1">
                                        <span class="material-symbols-outlined text-sm">@arrow</span>
                                        @Math.Abs(diff).ToString("C")
                                    </div>
                                </td>
                                <td class="px-4 py-2.5 text-right text-data-tabular font-data-tabular text-on-surface">$@api.High</td>
                                <td class="px-4 py-2.5 text-right text-data-tabular font-data-tabular text-on-surface">$@api.Low</td>
                                <td class="px-4 py-2.5 text-right text-data-tabular font-data-tabular text-slate-400">@api.Volume.ToString("N0")</td>
                            }
                            else
                            {
                                <td colspan="5" class="px-4 py-2.5 text-data-tabular text-slate-600 text-center">No market data available</td>
                            }

                            <td class="px-4 py-2.5">
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-action="Details" asp-route-id="@stock.Id"
                                       class="p-1 text-slate-400 hover:text-blue-400 transition-colors" title="Details">
                                        <span class="material-symbols-outlined" style="font-size:18px;">visibility</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@stock.Id"
                                       class="p-1 text-slate-400 hover:text-blue-400 transition-colors" title="Edit">
                                        <span class="material-symbols-outlined" style="font-size:18px;">edit</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@stock.Id"
                                       class="p-1 text-slate-400 hover:text-red-400 transition-colors" title="Delete">
                                        <span class="material-symbols-outlined" style="font-size:18px;">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between px-6 py-3 bg-surface-container-high text-on-surface-variant border-t border-outline-variant">
            <div class="text-label-caps font-label-caps">@Model.Count stock(s) in watchlist</div>
        </div>
    </div>
}
