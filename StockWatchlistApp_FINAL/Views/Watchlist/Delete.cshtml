@model StockWatchlistApp.Models.WatchlistStock

@{
    ViewData["Title"] = "Delete Stock";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6 col-md-8">
        <div class="mb-4">
            <h2 style="font-weight:700; letter-spacing:-0.02em;">Delete Stock</h2>
            <p style="color:#ff4d6d; font-size:0.9rem;">This action cannot be undone.</p>
        </div>

        <div class="card" style="border-color: rgba(255,77,109,0.3);">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ticker</dt>
                    <dd class="col-sm-8"><span class="ticker-badge">@Model.Ticker</span></dd>

                    <dt class="col-sm-4">Company</dt>
                    <dd class="col-sm-8">@Model.CompanyName</dd>

                    <dt class="col-sm-4">Target Price</dt>
                    <dd class="col-sm-8" style="color:#00d4aa; font-weight:600;">$@Model.TargetPrice</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category</dd>
                </dl>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">🗑 Confirm Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
