@model StockWatchlistApp.Models.WatchlistStock

@{
    ViewData["Title"] = "Delete Stock";
}

<div class="card shadow-sm mt-4">
    <div class="card-body p-4">
        <h1>Delete Stock</h1>
        <p class="text-danger">Are you sure you want to delete this stock from your watchlist?</p>

        <dl class="row">
            <dt class="col-sm-3">Ticker</dt>
            <dd class="col-sm-9">@Model.Ticker</dd>

            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.CompanyName</dd>

            <dt class="col-sm-3">Target Price</dt>
            <dd class="col-sm-9">$@Model.TargetPrice</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>