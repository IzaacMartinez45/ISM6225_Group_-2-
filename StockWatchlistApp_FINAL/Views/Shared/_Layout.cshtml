<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockTracker</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Work+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary-container": "#4d8eff",
                        "surface-container-high": "#272a31",
                        "surface-variant": "#32353c",
                        "on-surface-variant": "#c2c6d6",
                        "outline-variant": "#424754",
                        "surface-container-low": "#191b23",
                        "surface-container": "#1d2027",
                        "surface-container-lowest": "#0b0e15",
                        "surface": "#10131a",
                        "background": "#10131a",
                        "on-surface": "#e1e2ec",
                        "on-background": "#e1e2ec",
                        "primary": "#adc6ff",
                        "on-primary": "#002e6a",
                        "on-primary-container": "#00285d",
                        "secondary": "#b9c8de",
                        "tertiary": "#ffb786",
                        "outline": "#8c909f",
                        "primary-fixed-dim": "#adc6ff",
                        "surface-container-highest": "#32353c",
                        "secondary-container": "#39485a",
                        "on-secondary-container": "#a7b6cc",
                        "on-tertiary-container": "#461f00",
                        "tertiary-container": "#df7412",
                    },
                    fontFamily: {
                        "label-caps": ["Inter"],
                        "data-tabular": ["Inter"],
                        "body-sm": ["Inter"],
                        "body-base": ["Inter"],
                        "headline-md": ["Work Sans"],
                        "display-lg": ["Work Sans"],
                    },
                    fontSize: {
                        "label-caps": ["11px", { lineHeight: "1", letterSpacing: "0.05em", fontWeight: "700" }],
                        "data-tabular": ["13px", { lineHeight: "1.2", fontWeight: "500" }],
                        "body-sm": ["14px", { lineHeight: "1.4", fontWeight: "400" }],
                        "body-base": ["16px", { lineHeight: "1.5", fontWeight: "400" }],
                        "headline-md": ["24px", { lineHeight: "1.3", fontWeight: "500" }],
                        "display-lg": ["48px", { lineHeight: "1.1", letterSpacing: "-0.02em", fontWeight: "600" }],
                    },
                    spacing: {
                        "container-margin": "24px",
                        "stack-md": "16px",
                        "stack-xs": "4px",
                        "stack-sm": "8px",
                        "gutter": "16px",
                        "stack-lg": "32px",
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.5rem",
                        full: "0.75rem",
                    },
                },
            },
        };
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            font-size: 20px;
        }
        body { background-color: #10131a; color: #e1e2ec; }
        .stock-up { color: #4ade80; }
        .stock-down { color: #f87171; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0b0e15; }
        ::-webkit-scrollbar-thumb { background: #32353c; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #424754; }
        /* Validation errors */
        .field-validation-error { color: #f87171; font-size: 11px; display: block; margin-top: 4px; }
        .validation-summary-errors ul { list-style: none; padding: 0; margin: 0; }
        .validation-summary-errors li { color: #f87171; font-size: 11px; }
        input.input-validation-error, select.input-validation-error, textarea.input-validation-error {
            border-color: #f87171 !important;
        }
    </style>
</head>
<body class="font-body-base antialiased">

    <!-- Sidebar Navigation -->
    <aside class="fixed left-0 top-0 h-full w-64 bg-slate-950 border-r border-slate-800 flex flex-col py-4 z-50 font-['Work_Sans'] text-sm tracking-tight">
        <div class="px-6 mb-8">
            <h1 class="text-lg font-black text-blue-500 uppercase tracking-wider">StockTracker</h1>
            <p class="text-[10px] text-slate-500 font-medium uppercase tracking-widest mt-1">Terminal v1.0</p>
        </div>
        <nav class="flex-1 px-3 space-y-1">
            <a class="flex items-center px-3 py-2.5 rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-blue-400 bg-slate-900 border-r-2 border-blue-500" : "text-slate-500 hover:text-slate-300 hover:bg-slate-900/50") transition-all duration-200"
               asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined mr-3">dashboard</span>Dashboard
            </a>
            <a class="flex items-center px-3 py-2.5 rounded @(ViewContext.RouteData.Values["controller"]?.ToString() == "Watchlist" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-blue-400 bg-slate-900 border-r-2 border-blue-500" : "text-slate-500 hover:text-slate-300 hover:bg-slate-900/50") transition-all duration-200"
               asp-controller="Watchlist" asp-action="Index">
                <span class="material-symbols-outlined mr-3">list_alt</span>Watchlist
            </a>
            <a class="flex items-center px-3 py-2.5 rounded @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "text-blue-400 bg-slate-900 border-r-2 border-blue-500" : "text-slate-500 hover:text-slate-300 hover:bg-slate-900/50") transition-all duration-200"
               asp-controller="Watchlist" asp-action="Create">
                <span class="material-symbols-outlined mr-3">add_circle</span>Add Stock
            </a>
            <a class="flex items-center px-3 py-2.5 rounded @(ViewContext.RouteData.Values["action"]?.ToString() == "AboutUs" ? "text-blue-400 bg-slate-900 border-r-2 border-blue-500" : "text-slate-500 hover:text-slate-300 hover:bg-slate-900/50") transition-all duration-200"
               asp-controller="Home" asp-action="AboutUs">
                <span class="material-symbols-outlined mr-3">info</span>About
            </a>
        </nav>
        <div class="px-6 pt-4 border-t border-slate-800">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-[#4d8eff] flex items-center justify-center text-[#00285d] font-bold text-xs">ST</div>
                <div>
                    <div class="text-xs font-bold text-slate-200">ISM6225 Group 2</div>
                    <div class="text-[10px] text-slate-500">Spring 2026</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Top Bar -->
    <header class="fixed top-0 right-0 left-64 h-14 px-6 bg-slate-900 border-b border-slate-800 flex justify-between items-center z-40 font-['Work_Sans']">
        <div class="flex items-center flex-1">
            <span class="text-slate-500 font-label-caps text-label-caps uppercase">@ViewData["Title"]</span>
        </div>
        <div class="flex items-center gap-3">
            <span class="flex items-center text-[10px] text-green-500 font-bold bg-green-500/10 px-2 py-1 rounded">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>SYSTEMS OPERATIONAL
            </span>
        </div>
    </header>

    <!-- Main Content -->
    <main class="ml-64 pt-14 min-h-screen bg-background">
        <div class="p-container-margin">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="ml-64 py-3 px-6 bg-surface-container-lowest border-t border-outline-variant flex justify-between items-center">
        <div class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">Trading involves risk. Market data delayed.</div>
        <div class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">© 2026 ISM6225 Group 2 — StockTracker</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
