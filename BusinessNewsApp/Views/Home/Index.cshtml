@model List<BusinessNewsApp.Models.NewsArticle>

@{
    ViewData["Title"] = "Business News";
}

<h1>Top U.S. Business Headlines</h1>

<p><strong>Status Code:</strong> @ViewBag.StatusCode</p>

<p><strong>Raw JSON Response:</strong></p>
<pre>@ViewBag.RawJson</pre>

<hr />

@foreach (var article in Model)
{
    <p><strong>Source:</strong> @article.SourceName</p>
    <p><strong>Title:</strong> @article.Title</p>
    <p>
        <strong>URL:</strong>
        <a href="@article.Url" target="_blank">@article.Url</a>
    </p>
    <hr />
}