@{
    ViewData["Title"] = "Privacy";
}

<section class="news-page">
    <h1 class="news-title">Privacy</h1>
    <p class="news-subtitle">How this class project handles data.</p>

    <article class="news-item">
        <h2 class="news-item-title">What we collect</h2>
        <p>
            This app does not require user sign-in and does not collect personal account data.
            It only requests public business headlines from NewsAPI.
        </p>
    </article>

    <article class="news-item">
        <h2 class="news-item-title">How data is used</h2>
        <p>
            Article information (source, title, and URL) is shown on the Home page for browsing.
            Data is not sold or shared by this project.
        </p>
    </article>

    <article class="news-item">
        <h2 class="news-item-title">Third-party service</h2>
        <p>
            News content is provided by NewsAPI and subject to their terms and availability.
        </p>
    </article>
</section>
